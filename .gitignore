# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Node (in case any future skill ships helper scripts)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (same rationale)
__pycache__/
*.py[cod]
.venv/

# Local-only overrides
.env
.env.local
*.local

# >>> kai workspace (managed by workflow-workspace-init) >>>
# Raw kai runs and personal material are local-only.
/.kai/runs/
/.kai/local.json
/personal/
# Heavy binaries stay ignored inside the committed library.
library/**/*.mp3
library/**/*.har
library/**/*.zip
library/**/audio/
library/**/raw/
library/**/screenshots/
**/storageState*.json
# <<< kai workspace <<<

# persona-self: writing-style profile (intimate; never shared, never promoted)
.persona-self/

# Playwright MCP scratch directory (snapshots, console logs)
.playwright-mcp/
