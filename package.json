{
  "name": "kai",
  "version": "19.0.0",
  "description": "Kai plugin development tooling. Authoritative agents and skills live inside plugins/; one build writes release metadata and consumer artifacts.",
  "private": true,
  "scripts": {
    "validate": "node tools/validate-plugin.mjs",
    "build": "node tools/build.mjs --write",
    "build:check": "node tools/build.mjs --check",
    "docs:generate": "npm run build",
    "docs:check": "npm run build:check",
    "doctor": "node src/core/workspace-doctor.mjs",
    "host-contract": "node tools/host-contract.mjs --self-test",
    "host-contract:update": "node tools/host-contract.mjs --update",
    "proactive-runner": "node examples/proactive-runner/runner.mjs --self-test",
    "release-readiness": "node tools/release-readiness.mjs",
    "release-notes": "node tools/release-notes.mjs",
    "check-syntax": "node tools/check-syntax.mjs",
    "consumer-install:self-test": "node test/consumer-install-self-test.mjs",
    "test": "node --test test/repository-instructions-self-test.mjs test/release-automation-self-test.mjs test/workspace-current-self-test.mjs test/coordination-schema-self-test.mjs test/coordination-core-self-test.mjs test/publication-contract-self-test.mjs test/package-build-self-test.mjs test/consumer-install-self-test.mjs test/creative-screenplay-self-test.mjs",
    "extract:path": "node tools/extract-learn-path.js",
    "extract:module": "node tools/extract-learn-path.js --module",
    "status": "node src/core/work-status.mjs",
    "activity": "node src/core/activity.mjs",
    "observe:enable": "node src/core/observe-subagent.mjs --enable",
    "observe:status": "node src/core/observe-subagent.mjs --status",
    "observe:watch": "node src/core/observe-watch.mjs",
    "demo-zoom": "node src/creative/demo-zoom.mjs",
    "demo-zoom:verify": "node src/creative/demo-zoom.mjs --verify",
    "pack-preview": "node tools/pack-preview.mjs",
    "pack-preview:self-test": "node tools/pack-preview.mjs --self-test",
    "pack-preview:gate": "node tools/pack-preview.mjs --gate all",
    "creative-screenplay:self-test": "node test/creative-screenplay-self-test.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
