# kai — generate-audio / lectoria credentials
#
# Copy to `.env` at the plugin root (`cp .env.example .env`) and fill in your
# Azure values. `scripts/generate-audio.ps1` loads this file automatically, so
# callers never need these exported in their own shell.
#
# Auth: lectoria signs into Azure Speech either with `az login`
# (DefaultAzureCredential, no key needed) OR with AZURE_SPEECH_KEY below.

# --- Azure AI Speech (text-to-speech) ---
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_RESOURCE_ID=
# Optional: use a key instead of `az login`.
# AZURE_SPEECH_KEY=

# --- Azure OpenAI (script generation) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Optional voice overrides (defaults shown) ---
# LECTORIA_VOICE_EN=en-US-AvaMultilingualNeural
# LECTORIA_VOICE_ES=es-MX-DaliaNeural
