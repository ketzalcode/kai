{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "type": "command",
        "timeoutSec": 10,
        "command": "node \"${PLUGIN_ROOT}/scripts/observe-subagent.mjs\" subagentStart"
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "timeoutSec": 10,
        "command": "node \"${PLUGIN_ROOT}/scripts/observe-subagent.mjs\" subagentStop"
      }
    ]
  }
}
